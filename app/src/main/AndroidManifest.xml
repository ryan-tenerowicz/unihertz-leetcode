<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- M2: LeetCode over HTTPS, and the offline badge (PLAN §8.1). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Rev 25: long pack downloads ("Everything on …") run as a foreground job with a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- configChanges: a hardware-keyboard or touch-mode change must never recreate the
             activity mid-edit (PLAN §3). singleTask: a PTT relaunch just brings it forward. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|touchscreen"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The local runner (PLAN §7): its own process, killable on a timeout or crash. -->
        <service
            android:name=".runner.RunnerService"
            android:exported="false"
            android:process=":runner" />

        <!-- Type-aware completion with Jedi (PLAN §5.4, rev 38): its own process too. -->
        <service
            android:name=".runner.CompletionService"
            android:exported="false"
            android:process=":complete" />

        <!-- WorkManager's foreground service, declared as data sync for pack downloads (rev 25). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
